# Copy to .env and replace the secret before running.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Local default: zero-dependency SQLite. Uncomment the PostgreSQL URL for a
# production-like run (the psycopg driver is already installed).
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://survey:survey@localhost:5432/survey

# Header identification is for the demo/API evaluation only.
SURVEY_ALLOW_HEADER_AUTH=true
DJANGO_LOG_LEVEL=INFO

# Used by docker-compose.yml.
POSTGRES_PASSWORD=demo-survey-password
# Log viewer (Dozzle) UI port in docker-compose.
DOZZLE_PORT=9999
